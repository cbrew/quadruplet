## masc.fcfg: a benchmark grammar with Montague-style semantics, written
## for sentences sampled from the MASC Penn Treebank (see README.md).
##
## The rules are written by hand. The lexicon, at the end of the file, is
## generated from the sample's trees by tools/masc/lexicon.py, which
## rewrites everything after the "generated lexicon" line.
##
## Semantic types, as in Montague's PTQ:
##   NP     generalised quantifier   \P.P(john)
##   Det    relation on properties   \P Q.exists x.(P(x) & Q(x))
##   N, Nom, A, AP, VP, PP, Pred     properties   \x.dog(x)
##   V[tr]  takes an NP meaning      \X y.X(\x.see(y,x))
##   Adv, Neg, Aux, Prt              operators on propositions  \p.often(p)
##   S      proposition
##   P      relation                 \x y.in(x,y)
## A PP is a property, of the subject when it modifies a noun and of the
## proposition when it modifies a VP or S: "walks in a park" is
## exists y.(park(y) & in(walk(x), y)).
##
## Gaps are slash categories: VPgap, Sgap, PPgap, SbarGap and SInvGap are
## VP/NP, S/NP and so on, and their meanings abstract over the gap
## (\z.  ...). Only the rules below pass a gap on.
##
## Features:
##   agr     3sg | non3sg          subject-verb and determiner-noun agreement
##   case    nom | acc             on pronouns
##   expl    no | there            NP: expletive "there" or not
##   subj    no | there            VP, Pred: whether the subject must be "there"
##   vform   fin | base | ing | en | pass | to
##   subcat  intr | tr | ditr | scomp | qcomp | vpto | vping | vpbase |
##           npvpto | npvpbase | pred       (V);  none | vpto  (A)
##   comp    base | en | ing | pass | to   the VP form an Aux takes
##   free    yes | no              Wh: can head a free relative ("what")
##   restr   a property            QPro: the restriction of "everything", "those"

############################################################################
# Sentences
############################################################################

Top[sem=<?s>] -> S[sem=<?s>]
Top[sem=<?q>] -> Q[sem=<?q>]
# imperatives, and the subjectless diary style of tweets
Top[sem=<?vp(hearer)>] -> VP[vform=base, sem=<?vp>]
Top[sem=<?vp(speaker)>] -> VP[vform=fin, sem=<?vp>]
Top[sem=<?vp(speaker)>] -> VP[vform=ing, sem=<?vp>]

S[sem=<?np(?vp)>] -> NP[case=nom, agr=?a, expl=?e, sem=<?np>] VP[vform=fin, agr=?a, subj=?e, sem=<?vp>]
S[sem=<?cj(?s1, ?s2)>] -> S[sem=<?s1>] Conj[sem=<?cj>] S[sem=<?s2>]
S[sem=<?s>] -> Conj[] S[sem=<?s>]
S[sem=<?adv(?s)>] -> Adv[sem=<?adv>] S[sem=<?s>]
S[sem=<?pp(?s)>] -> PP[sem=<?pp>] S[sem=<?s>]
S[sem=<?sub(?s1, ?s2)>] -> Sub[sem=<?sub>] S[sem=<?s1>] S[sem=<?s2>]

Sbar[sem=<?s>] -> "that" S[sem=<?s>] | S[sem=<?s>]

############################################################################
# Questions
############################################################################

Q[sem=<ynq(?s)>] -> SInv[sem=<?s>]
Q[sem=<\x.(?w(x) & ?s(x))>] -> Wh[sem=<?w>] SInvGap[sem=<?s>]
Q[sem=<\x.(?w(x) & ?vp(x))>] -> Wh[sem=<?w>] VP[vform=fin, sem=<?vp>]
Q[sem=<\y.?w(?s, y)>] -> WhAdv[sem=<?w>] SInv[sem=<?s>]

SInv[sem=<?np(\x.?aux(?vp(x)))>] -> Aux[vform=fin, agr=?a, comp=?c, sem=<?aux>] NP[case=nom, agr=?a, expl=?e, sem=<?np>] VP[vform=?c, subj=?e, sem=<?vp>]
SInv[sem=<?np(?p)>] -> Be[vform=fin, agr=?a] NP[case=nom, agr=?a, expl=?e, sem=<?np>] Pred[subj=?e, sem=<?p>]
SInvGap[sem=<\z.?np(\x.?aux(?vp(z, x)))>] -> Aux[vform=fin, agr=?a, comp=?c, sem=<?aux>] NP[case=nom, agr=?a, expl=no, sem=<?np>] VPgap[vform=?c, sem=<?vp>]
SInvGap[sem=<\z.?np(\x.(x = z))>] -> Be[vform=fin, agr=?a] NP[case=nom, agr=?a, expl=no, sem=<?np>]

# embedded questions
Qemb[sem=<\y.?w(?s, y)>] -> WhAdv[sem=<?w>] S[sem=<?s>]
Qemb[sem=<\x.(?w(x) & ?s(x))>] -> Wh[sem=<?w>] Sgap[sem=<?s>]
Qemb[sem=<\x.(?w(x) & ?vp(x))>] -> Wh[sem=<?w>] VP[vform=fin, sem=<?vp>]

############################################################################
# Verb phrases
############################################################################

VP[vform=?f, agr=?a, sem=<?v>] -> V[vform=?f, agr=?a, subcat=intr, sem=<?v>]
VP[vform=?f, agr=?a, sem=<?v(?np)>] -> V[vform=?f, agr=?a, subcat=tr, sem=<?v>] NP[case=acc, expl=no, sem=<?np>]
VP[vform=?f, agr=?a, sem=<?v(?np1, ?np2)>] -> V[vform=?f, agr=?a, subcat=ditr, sem=<?v>] NP[case=acc, expl=no, sem=<?np1>] NP[case=acc, expl=no, sem=<?np2>]
VP[vform=?f, agr=?a, sem=<?v(?s)>] -> V[vform=?f, agr=?a, subcat=scomp, sem=<?v>] Sbar[sem=<?s>]
VP[vform=?f, agr=?a, sem=<?v(?q)>] -> V[vform=?f, agr=?a, subcat=qcomp, sem=<?v>] Qemb[sem=<?q>]
VP[vform=?f, agr=?a, sem=<?v(?vp)>] -> V[vform=?f, agr=?a, subcat=vpto, sem=<?v>] VP[vform=to, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<?v(?vp)>] -> V[vform=?f, agr=?a, subcat=vping, sem=<?v>] VP[vform=ing, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<?v(?vp)>] -> V[vform=?f, agr=?a, subcat=vpbase, sem=<?v>] VP[vform=base, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<?v(?vp, ?np)>] -> V[vform=?f, agr=?a, subcat=npvpto, sem=<?v>] NP[case=acc, expl=no, sem=<?np>] VP[vform=to, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<?v(?vp, ?np)>] -> V[vform=?f, agr=?a, subcat=npvpbase, sem=<?v>] NP[case=acc, expl=no, sem=<?np>] VP[vform=base, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<?v(?ap)>] -> V[vform=?f, agr=?a, subcat=pred, sem=<?v>] AP[sem=<?ap>]
# a particle between a verb and its object: "call up the synonyms"
VP[vform=?f, agr=?a, sem=<\x.?prt(?v(?np, x))>] -> V[vform=?f, agr=?a, subcat=tr, sem=<?v>] Prt[sem=<?prt>] NP[case=acc, expl=no, sem=<?np>]

VP[vform=to, subj=?e, sem=<?vp>] -> "to" VP[vform=base, subj=?e, sem=<?vp>]

# auxiliaries and modals, negated, and with the VP elided ("they always have")
VP[vform=?f, agr=?a, subj=?e, sem=<\x.?aux(?vp(x))>] -> Aux[vform=?f, agr=?a, comp=?c, sem=<?aux>] VP[vform=?c, subj=?e, sem=<?vp>]
VP[vform=?f, agr=?a, subj=?e, sem=<\x.?aux(?neg(?vp(x)))>] -> Aux[vform=?f, agr=?a, comp=?c, sem=<?aux>] Neg[sem=<?neg>] VP[vform=?c, subj=?e, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<\x.?aux(elided(x))>] -> Aux[vform=?f, agr=?a, sem=<?aux>]
VP[vform=?f, agr=?a, sem=<\x.?aux(?neg(elided(x)))>] -> Aux[vform=?f, agr=?a, sem=<?aux>] Neg[sem=<?neg>]

# the copula
VP[vform=?f, agr=?a, subj=?e, sem=<?p>] -> Be[vform=?f, agr=?a] Pred[subj=?e, sem=<?p>]
VP[vform=?f, agr=?a, subj=?e, sem=<\x.?neg(?p(x))>] -> Be[vform=?f, agr=?a] Neg[sem=<?neg>] Pred[subj=?e, sem=<?p>]
VP[vform=?f, agr=?a, sem=<\x.elided(x)>] -> Be[vform=?f, agr=?a]
VP[vform=?f, agr=?a, sem=<\x.?neg(elided(x))>] -> Be[vform=?f, agr=?a] Neg[sem=<?neg>]

Pred[subj=no, sem=<\x.?np(\y.(x = y))>] -> NP[expl=no, sem=<?np>]
Pred[subj=there, sem=<\x.?np(\y.exist(y))>] -> NP[expl=no, sem=<?np>]
Pred[sem=<?ap>] -> AP[sem=<?ap>]
Pred[sem=<?pp>] -> PP[sem=<?pp>]
# "the goal is to test the interest"
Pred[sem=<?vp>] -> VP[vform=to, sem=<?vp>]
Pred[subj=?e, sem=<\x.?adv(?p(x))>] -> Adv[sem=<?adv>] Pred[subj=?e, sem=<?p>]

# passives, with and without an agent
VP[vform=pass, sem=<\y.exists x.?v(\P.P(y), x)>] -> V[vform=en, subcat=tr, sem=<?v>]
VP[vform=pass, sem=<\y.?np(\x.?v(\P.P(y), x))>] -> V[vform=en, subcat=tr, sem=<?v>] "by" NP[case=acc, expl=no, sem=<?np>]
# "was thought to distract"
VP[vform=pass, sem=<\y.exists x.?v(?vp, \P.P(y), x)>] -> V[vform=en, subcat=npvpto, sem=<?v>] VP[vform=to, sem=<?vp>]

# modifiers and coordination
VP[vform=?f, agr=?a, subj=?e, sem=<\x.?adv(?vp(x))>] -> Adv[sem=<?adv>] VP[vform=?f, agr=?a, subj=?e, sem=<?vp>]
VP[vform=?f, agr=?a, subj=?e, sem=<\x.?adv(?vp(x))>] -> VP[vform=?f, agr=?a, subj=?e, sem=<?vp>] Adv[sem=<?adv>]
VP[vform=?f, agr=?a, subj=?e, sem=<\x.?pp(?vp(x))>] -> VP[vform=?f, agr=?a, subj=?e, sem=<?vp>] PP[sem=<?pp>]
VP[vform=?f, agr=?a, subj=?e, sem=<\x.?prt(?vp(x))>] -> VP[vform=?f, agr=?a, subj=?e, sem=<?vp>] Prt[sem=<?prt>]
VP[vform=?f, agr=?a, subj=?e, sem=<\x.?sub(?s, ?vp(x))>] -> VP[vform=?f, agr=?a, subj=?e, sem=<?vp>] Sub[sem=<?sub>] S[sem=<?s>]
# purpose ("coming here to work") and participial ("wrote it using tags") adjuncts
VP[vform=?f, agr=?a, subj=?e, sem=<\x.purpose(?vp1(x), ?vp2(x))>] -> VP[vform=?f, agr=?a, subj=?e, sem=<?vp1>] VP[vform=to, sem=<?vp2>]
VP[vform=?f, agr=?a, subj=?e, sem=<\x.(?vp1(x) & ?vp2(x))>] -> VP[vform=?f, agr=?a, subj=?e, sem=<?vp1>] VP[vform=ing, sem=<?vp2>]
VP[vform=?f, agr=?a, sem=<\x.?cj(?vp1(x), ?vp2(x))>] -> VP[vform=?f, agr=?a, sem=<?vp1>] Conj[sem=<?cj>] VP[vform=?f, agr=?a, sem=<?vp2>]

############################################################################
# Gaps
############################################################################

Sgap[sem=<\z.?np(?vp(z))>] -> NP[case=nom, agr=?a, expl=no, sem=<?np>] VPgap[vform=fin, agr=?a, sem=<?vp>]
SbarGap[sem=<?s>] -> Sgap[sem=<?s>]

VPgap[vform=?f, agr=?a, sem=<\z.?v(\P.P(z))>] -> V[vform=?f, agr=?a, subcat=tr, sem=<?v>]
VPgap[vform=?f, agr=?a, sem=<\z.?v(?vp, \P.P(z))>] -> V[vform=?f, agr=?a, subcat=npvpto, sem=<?v>] VP[vform=to, sem=<?vp>]
VPgap[vform=?f, agr=?a, sem=<\z.?v(z)>] -> V[vform=?f, agr=?a, subcat=scomp, sem=<?v>]
VPgap[vform=?f, agr=?a, sem=<\z.?v(?s(z))>] -> V[vform=?f, agr=?a, subcat=scomp, sem=<?v>] SbarGap[sem=<?s>]
VPgap[vform=?f, agr=?a, sem=<\z.?v(?vp(z))>] -> V[vform=?f, agr=?a, subcat=vpto, sem=<?v>] VPgap[vform=to, sem=<?vp>]
VPgap[vform=to, sem=<?vp>] -> "to" VPgap[vform=base, sem=<?vp>]
VPgap[vform=?f, agr=?a, sem=<\z x.?aux(?vp(z, x))>] -> Aux[vform=?f, agr=?a, comp=?c, sem=<?aux>] VPgap[vform=?c, sem=<?vp>]
VPgap[vform=?f, agr=?a, sem=<\z x.(x = z)>] -> Be[vform=?f, agr=?a]
VPgap[vform=?f, agr=?a, sem=<\z x.?adv(?vp(z, x))>] -> Adv[sem=<?adv>] VPgap[vform=?f, agr=?a, sem=<?vp>]
VPgap[vform=?f, agr=?a, sem=<\z x.?pp(?vp(z, x))>] -> VPgap[vform=?f, agr=?a, sem=<?vp>] PP[sem=<?pp>]
VPgap[vform=?f, agr=?a, sem=<\z x.?pp(z, ?vp(x))>] -> VP[vform=?f, agr=?a, sem=<?vp>] PPgap[sem=<?pp>]
PPgap[sem=<\z x.?p(x, z)>] -> P[sem=<?p>]

############################################################################
# Noun phrases
############################################################################

NP[agr=?a, expl=no, sem=<?d(?n)>] -> Det[agr=?a, sem=<?d>] Nom[agr=?a, sem=<?n>]
NP[agr=?a, expl=no, sem=<\Q.exists x.(?n(x) & Q(x))>] -> Nom[agr=?a, sem=<?n>]
NP[expl=no, sem=<\P.?cj(?np1(P), ?np2(P))>] -> NP[expl=no, sem=<?np1>] Conj[sem=<?cj>] NP[expl=no, sem=<?np2>]
# quantified pronouns, which can take a relative clause: "somebody who cares"
NP[agr=?a, expl=no, sem=<?d(?r)>] -> QPro[agr=?a, restr=<?r>, sem=<?d>]
NP[agr=?a, expl=no, sem=<?d(\x.(?r(x) & ?rc(x)))>] -> QPro[agr=?a, restr=<?r>, sem=<?d>] RelC[sem=<?rc>]
# partitives: "some of the analysis"
NP[expl=no, sem=<\Q.?d(\x.?np(\y.of(x, y)), Q)>] -> Det[sem=<?d>] "of" NP[case=acc, expl=no, sem=<?np>]
# free relatives: "what she said"
NP[agr=3sg, expl=no, sem=<\Q.exists x.((?w(x) & ?s(x)) & Q(x))>] -> Wh[free=yes, sem=<?w>] Sgap[sem=<?s>]
NP[agr=3sg, expl=no, sem=<\Q.exists x.((?w(x) & ?vp(x)) & Q(x))>] -> Wh[free=yes, sem=<?w>] VP[vform=fin, sem=<?vp>]

# possessives: "the guy's"
Det[sem=<\P Q.?np(\y.exists x.((P(x) & of(x, y)) & Q(x)))>] -> NP[expl=no, sem=<?np>] Poss[]

Nom[agr=?a, sem=<?n>] -> N[agr=?a, sem=<?n>]
Nom[agr=?a, sem=<\x.(?ap(x) & ?n(x))>] -> AP[sem=<?ap>] Nom[agr=?a, sem=<?n>]
# noun compounds: "school system"
Nom[agr=?a, sem=<\x.(?n(x) & exists y.(?m(y) & nn(x, y)))>] -> N[sem=<?m>] Nom[agr=?a, sem=<?n>]
Nom[agr=?a, sem=<\x.(?n(x) & ?pp(x))>] -> Nom[agr=?a, sem=<?n>] PP[sem=<?pp>]
Nom[agr=?a, sem=<\x.(?n(x) & ?r(x))>] -> Nom[agr=?a, sem=<?n>] RelC[sem=<?r>]
# infinitival and reduced relatives: "a factor to be considered", "kids shooting kids"
Nom[agr=?a, sem=<\x.(?n(x) & purpose(x, ?vp))>] -> Nom[agr=?a, sem=<?n>] VP[vform=to, sem=<?vp>]
Nom[agr=?a, sem=<\x.(?n(x) & ?vp(x))>] -> Nom[agr=?a, sem=<?n>] VP[vform=ing, sem=<?vp>]
Nom[agr=?a, sem=<\x.(?n(x) & ?vp(x))>] -> Nom[agr=?a, sem=<?n>] VP[vform=pass, sem=<?vp>]
Nom[agr=?a, sem=<\x.?cj(?n1(x), ?n2(x))>] -> Nom[agr=?a, sem=<?n1>] Conj[sem=<?cj>] Nom[agr=?a, sem=<?n2>]

# relative clauses
RelC[sem=<?vp>] -> Wh[free=no] VP[vform=fin, sem=<?vp>]
RelC[sem=<?s>] -> Wh[free=no] Sgap[sem=<?s>] | Sgap[sem=<?s>]
RelC[sem=<\y.?w(?s, y)>] -> WhAdv[sem=<?w>] S[sem=<?s>]

############################################################################
# Adjective and prepositional phrases
############################################################################

AP[sem=<?a>] -> A[subcat=none, sem=<?a>]
AP[sem=<?a(?vp)>] -> A[subcat=vpto, sem=<?a>] VP[vform=to, sem=<?vp>]
AP[sem=<\x.?adv(?ap(x))>] -> Adv[sem=<?adv>] AP[sem=<?ap>]
AP[sem=<\x.(?ap(x) & ?pp(x))>] -> AP[sem=<?ap>] PP[sem=<?pp>]
AP[sem=<\x.?cj(?ap1(x), ?ap2(x))>] -> AP[sem=<?ap1>] Conj[sem=<?cj>] AP[sem=<?ap2>]

PP[sem=<\x.?np(\y.?p(x, y))>] -> P[sem=<?p>] NP[case=acc, expl=no, sem=<?np>]

############################################################################
# generated lexicon: everything below is written by tools/masc/lexicon.py
############################################################################

"'d": Aux[vform=fin, comp=base, sem=<\p.would(p)>] | Aux[vform=fin, comp=en, sem=<\p.perf(p)>] | Aux[vform=fin, comp=to, sem=<\p.must(p)>]
"'em": NP[agr=non3sg, case=acc, expl=no, sem=<\P.P(they)>]
"'ll": Aux[vform=fin, comp=base, sem=<\p.will(p)>]
"'m": Aux[vform=fin, agr=non3sg, comp=ing, sem=<\p.prog(p)>] | Aux[vform=fin, agr=non3sg, comp=pass, sem=<\p.p>] | Be[vform=fin, agr=non3sg]
"'re": Aux[vform=fin, agr=non3sg, comp=ing, sem=<\p.prog(p)>] | Aux[vform=fin, agr=non3sg, comp=pass, sem=<\p.p>] | Be[vform=fin, agr=non3sg]
"'s": Aux[vform=fin, agr=3sg, comp=en, sem=<\p.perf(p)>] | Aux[vform=fin, agr=3sg, comp=ing, sem=<\p.prog(p)>] | Aux[vform=fin, agr=3sg, comp=pass, sem=<\p.p>] | Aux[vform=fin, agr=3sg, comp=to, sem=<\p.must(p)>] | Be[vform=fin, agr=3sg]
"'til": Sub[sem=<\p q.til(q, p)>]
"'ve": Aux[vform=fin, agr=non3sg, comp=en, sem=<\p.perf(p)>] | Aux[vform=fin, agr=non3sg, comp=to, sem=<\p.must(p)>]
"+": N[agr=3sg, sem=<\x.w_(x)>]
"-": N[agr=3sg, sem=<\x.w_(x)>]
"1300": N[agr=3sg, sem=<\x.w_1300(x)>]
"1973": N[agr=3sg, sem=<\x.w_1973(x)>]
"1°SS": NP[agr=3sg, expl=no, sem=<\P.P(w_1_ss)>]
"9/11": NP[agr=3sg, expl=no, sem=<\P.P(w_9_11)>]
"?s": Poss[]
"a": Det[agr=3sg, sem=<\P Q.exists x.(P(x) & Q(x))>]
"a few": Det[agr=non3sg, sem=<\P Q.few(P, Q)>]
"abortion": N[agr=3sg, sem=<\x.abortion(x)>]
"abounds": V[vform=fin, agr=3sg, subcat=intr, sem=<\x.abound(x)>]
"about": P[sem=<\x y.about(x, y)>]
"academics": N[agr=non3sg, sem=<\x.academic(x)>]
"accessed": V[vform=en, subcat=tr, sem=<\X y.X(\x.access(y, x))>]
"account": N[agr=3sg, sem=<\x.account(x)>]
"accounts": N[agr=non3sg, sem=<\x.account(x)>]
"acknowledge": V[vform=fin, agr=non3sg, subcat=intr, sem=<\x.acknowledge(x)>]
"acknowledgement": N[agr=3sg, sem=<\x.acknowledgement(x)>]
"activities": N[agr=non3sg, sem=<\x.activity(x)>]
"actually": Adv[sem=<\p.actually(p)>]
"additional": A[subcat=none, sem=<\x.additional(x)>]
"address": N[agr=3sg, sem=<\x.address(x)>]
"addresses": N[agr=non3sg, sem=<\x.address(x)>]
"adj": N[agr=3sg, sem=<\x.adj(x)>]
"administration": N[agr=3sg, sem=<\x.administration(x)>]
"Adobe": NP[agr=3sg, expl=no, sem=<\P.P(adobe)>]
"adopted": V[vform=fin, subcat=tr, sem=<\X y.X(\x.adopt(y, x))>]
"adults": N[agr=non3sg, sem=<\x.adult(x)>]
"advance": N[agr=3sg, sem=<\x.advance(x)>]
"advantages": N[agr=non3sg, sem=<\x.advantage(x)>]
"advertisement": N[agr=3sg, sem=<\x.advertisement(x)>]
"Afghanistan": NP[agr=3sg, expl=no, sem=<\P.P(afghanistan)>]
"after": P[sem=<\x y.after(x, y)>]
"again": Adv[sem=<\p.again(p)>]
"against": P[sem=<\x y.against(x, y)>]
"ai": Aux[vform=fin, agr=non3sg, comp=ing, sem=<\p.ai(p)>]
"al": NP[agr=3sg, expl=no, sem=<\P.P(al)>] | N[agr=3sg, sem=<\x.al(x)>]
"alcohol": N[agr=3sg, sem=<\x.alcohol(x)>]
"all": Adv[sem=<\p.all_(p)>] | Det[agr=non3sg, sem=<\P Q.all x.(P(x) -> Q(x))>] | QPro[agr=non3sg, restr=<\x.thing(x)>, sem=<\P Q.all x.(P(x) -> Q(x))>]
"alliance": N[agr=3sg, sem=<\x.alliance(x)>]
"allows": V[vform=fin, agr=3sg, subcat=npvpto, sem=<\P X y.X(\x.allow(y, x, P(x)))>]
"almost": Adv[sem=<\p.almost(p)>]
"also": Adv[sem=<\p.also(p)>]
"although": Sub[sem=<\p q.although(q, p)>]
"always": Adv[sem=<\p.always(p)>]
"am": Aux[vform=fin, agr=non3sg, comp=ing, sem=<\p.prog(p)>] | Aux[vform=fin, agr=non3sg, comp=pass, sem=<\p.p>] | Be[vform=fin, agr=non3sg]
"AMC": NP[agr=3sg, expl=no, sem=<\P.P(amc)>]
"America": NP[agr=3sg, expl=no, sem=<\P.P(america)>]
"american": A[subcat=none, sem=<\x.american(x)>]
"an": Det[agr=3sg, sem=<\P Q.exists x.(P(x) & Q(x))>]
"analysis": N[agr=3sg, sem=<\x.analysis(x)>]
"ananimous": A[subcat=none, sem=<\x.ananimous(x)>]
