"works": V[vform=fin, agr=3sg, subcat=intr, sem=<\x F.exists e.(work(e) & Agent(e, x) & F(e))>]
"world": N[agr=3sg, sem=<\x.world(x)>]
"worldwide": A[subcat=none, sem=<\x.worldwide(x)>]
"would": Aux[vform=fin, comp=base, ell=yes, sem=<\p.would(p)>]
"write": V[vform=base, subcat=ditr, sem=<\X Y z F.X(\x.Y(\y.exists e.(write(e) & Agent(e, z) & Recipient(e, x) & Theme(e, y) & F(e))))>] | V[vform=base, subcat=tr, sem=<\X y F.X(\x.exists e.(write(e) & Agent(e, y) & Theme(e, x) & F(e)))>]
"written": V[vform=en, subcat=ditr, sem=<\X Y z F.X(\x.Y(\y.exists e.(write(e) & Agent(e, z) & Recipient(e, x) & Theme(e, y) & F(e))))>] | V[vform=en, subcat=tr, sem=<\X y F.X(\x.exists e.(write(e) & Agent(e, y) & Theme(e, x) & F(e)))>]
"x": N[agr=3sg, sem=<\x.x_(x)>]
"x_e": N[agr=3sg, sem=<\x.x_e(x)>]
"yet": Adv[type=op, sem=<\p.yet(p)>]
"yhl": N[agr=3sg, sem=<\x.yhl(x)>]
"yol": N[agr=3sg, sem=<\x.yol(x)>]
"you": NP[agr=non3sg, expl=no, sem=<\P.P(hearer)>]
"young": A[subcat=none, sem=<\x.young(x)>]
"younger": A[subcat=none, sem=<\x.younger(x)>]
"your": Det[sem=<\P Q.exists x.((P(x) & of(x, hearer)) & Q(x))>]
"yourself": NP[agr=non3sg, case=acc, expl=no, sem=<\P.P(hearer)>]
