## masc-heldout.fcfg is generated by tools/masc/lexicon.py: the rules of masc.fcfg with a
## lexicon from heldout.mrg. Do not edit it; edit masc.fcfg and regenerate.
##
## masc.fcfg, version 0: a benchmark grammar with an extensional Montague
## semantics and quantificational event semantics, written for sentences
## sampled from the MASC Penn Treebank (see README.md). docs/semantics.md
## explains the ideas behind it.
##
## The rules are written by hand. The lexicon, at the end of the file, is
## generated from the sample's trees by tools/masc/lexicon.py, which
## rewrites everything after the "generated lexicon" line.
##
## The semantics is Montague's, with neo-Davidsonian events added as in
## Champollion's quantificational event semantics (The interaction of
## compositional semantics and event semantics, L&P 38, 2015): a verb
## phrase takes its subject and then a condition F on its event, and
## existentially quantifies over the event itself,
##
##   walks            \x F.exists e.(walk(e) & Agent(e, x) & F(e))
##   sees every dog   \x F.all y.(dog(y) -> exists e.(see(e) & Agent(e, x) & Theme(e, y) & F(e)))
##
## so the event quantifier takes scope below the verb's arguments,
## negation and modals (but above quantifiers inside modifiers). Modifiers of the event (PPs, manner
## and place adverbs, particles, purpose clauses) are added to F; a
## sentence is closed with \e.true, which conjunction drops.
##
## Semantic types (e individuals, v events, t truth values, Ev the event
## quantifiers (v->t)->t):
##   NP                        (e->t)->t  \P.P(john)
##   Det                       (e->t)->(e->t)->t
##   N, Nom, A, AP, PP, RelC   e->t       \x.dog(x); a PP can also hold of an event
##   VP                        e->Ev      \x F.exists e.(...)
##   S, SInv                   Ev         \F.exists e.(...)
##   VPgap                     e->e->Ev   the gap, then the subject
##   Sgap, SInvGap             e->Ev
##   Sbar                      t;  SbarGap  e->t
##   Pred                      e->Ev      what the copula makes of its complement
##   Adv[type=ev]              v->t       \e.quickly(e)
##   Adv[type=op], Neg, Aux    t->t       \p.always(p)
##   Prt                       v->t       \e.up(e)
##   Sub, Conj                 t->t->t
##   P                         e->e->t    \x y.in(x, y)
##   Wh                        e->t;  WhAdv  v->e->t, a relation to the event
##
## Gaps are slash categories: VPgap, Sgap, PPgap, SbarGap and SInvGap are
## VP/NP, S/NP and so on, and their meanings abstract over the gap
## (\z. ...). Only the rules below pass a gap on.
##
## Features:
##   agr     3sg | non3sg          subject-verb and determiner-noun agreement
##   case    nom | acc             on pronouns
##   expl    no | there            NP: expletive "there" or not
##   subj    no | there            VP, Pred: whether the subject must be "there"
##   vform   fin | base | ing | en | pass | to
##   subcat  intr | tr | ditr | scomp | qcomp | npscomp | npqcomp | vpto |
##           vping | vpbase | npvpto | npvpbase | pred   (V);
##           none | vpto | deg  (A)
##   comp    base | en | ing | pass | to   the VP form an Aux takes
##   ell     yes | no              Aux: can end an elliptical VP (do, modals, have)
##   cop     yes | no              VP: made by the copula
##   ell     yes | no              VP: elliptical
##   type    ev | op               Adv: modifies the event, or is an operator
##   pre     yes | no              Adv[type=ev]: can precede the VP (manner, not place or time)
##   free    yes | no              Wh: can head a free relative ("what"); NP: is one
##   restr   a property            QPro: the restriction of "everything", "those"

############################################################################
# Sentences
############################################################################

Top[sem=<?s(\e.true)>] -> S[sem=<?s>]
Top[sem=<?q>] -> Q[sem=<?q>]
# imperatives, and the subjectless diary style of tweets
Top[sem=<?vp(hearer, \e.true)>] -> VP[vform=base, subj=no, sem=<?vp>]
Top[sem=<?vp(speaker, \e.true)>] -> VP[vform=fin, subj=no, sem=<?vp>]
Top[sem=<?vp(speaker, \e.true)>] -> VP[vform=ing, subj=no, sem=<?vp>]
Top[sem=<?vp(speaker, \e.true)>] -> Conj[] VP[vform=fin, subj=no, sem=<?vp>]
# headlines: "Mac OS X updating"
Top[sem=<?np(\x.?vp(x, \e.true))>] -> NP[case=nom, expl=no, free=no, sem=<?np>] VP[vform=ing, subj=no, sem=<?vp>]

S[sem=<\F.?np(\x.?vp(x, F))>] -> NP[case=nom, agr=?a, expl=?e, sem=<?np>] VP[vform=fin, agr=?a, subj=?e, sem=<?vp>]
S[sem=<\F.?cj(?s1(F), ?s2(F))>] -> S[sem=<?s1>] Conj[sem=<?cj>] S[sem=<?s2>]
S[sem=<?s>] -> Conj[] S[sem=<?s>]
S[sem=<\F.?adv(?s(F))>] -> Adv[type=op, sem=<?adv>] S[sem=<?s>]
S[sem=<\F.?s(\e.(?adv(e) & F(e)))>] -> Adv[type=ev, sem=<?adv>] S[sem=<?s>]
S[sem=<\F.?s(\e.(?pp(e) & F(e)))>] -> PP[sem=<?pp>] S[sem=<?s>]
S[sem=<\F.?sub(?s1(\e.true), ?s2(F))>] -> Sub[sem=<?sub>] S[sem=<?s1>] S[sem=<?s2>]

Sbar[sem=<?s(\e.true)>] -> "that" S[sem=<?s>] | S[sem=<?s>]

############################################################################
# Questions
############################################################################

Q[sem=<ynq(?s(\e.true))>] -> SInv[sem=<?s>]
Q[sem=<\x.(?w(x) & ?s(x, \e.true))>] -> Wh[sem=<?w>] SInvGap[sem=<?s>]
Q[sem=<\x.(?w(x) & ?vp(x, \e.true))>] -> Wh[sem=<?w>] VP[vform=fin, sem=<?vp>]
Q[sem=<\y.?s(\e.?w(e, y))>] -> WhAdv[sem=<?w>] SInv[sem=<?s>]

SInv[sem=<\F.?np(\x.?aux(?vp(x, F)))>] -> Aux[vform=fin, agr=?a, comp=?c, sem=<?aux>] NP[case=nom, agr=?a, expl=?e, sem=<?np>] VP[vform=?c, subj=?e, sem=<?vp>]
SInv[sem=<\F.?np(\x.?p(x, F))>] -> Be[vform=fin, agr=?a] NP[case=nom, agr=?a, expl=?e, sem=<?np>] Pred[subj=?e, sem=<?p>]
SInvGap[sem=<\z F.?np(\x.?aux(?vp(z, x, F)))>] -> Aux[vform=fin, agr=?a, comp=?c, sem=<?aux>] NP[case=nom, agr=?a, expl=no, sem=<?np>] VPgap[vform=?c, sem=<?vp>]
SInvGap[sem=<\z F.?np(\x.exists e.(be(e) & Theme(e, x) & (x = z) & F(e)))>] -> Be[vform=fin, agr=?a] NP[case=nom, agr=?a, expl=no, sem=<?np>]

# embedded questions
Qemb[sem=<\y.?s(\e.?w(e, y))>] -> WhAdv[sem=<?w>] S[sem=<?s>]
Qemb[sem=<\x.(?w(x) & ?s(x, \e.true))>] -> Wh[sem=<?w>] Sgap[sem=<?s>]
Qemb[sem=<\x.(?w(x) & ?vp(x, \e.true))>] -> Wh[sem=<?w>] VP[vform=fin, sem=<?vp>]

############################################################################
# Verb phrases
############################################################################

VP[vform=?f, agr=?a, sem=<?v>] -> V[vform=?f, agr=?a, subcat=intr, sem=<?v>]
VP[vform=?f, agr=?a, sem=<?v(?np)>] -> V[vform=?f, agr=?a, subcat=tr, sem=<?v>] NP[case=acc, expl=no, sem=<?np>]
VP[vform=?f, agr=?a, sem=<?v(?np1, ?np2)>] -> V[vform=?f, agr=?a, subcat=ditr, sem=<?v>] NP[case=acc, expl=no, sem=<?np1>] NP[case=acc, expl=no, sem=<?np2>]
VP[vform=?f, agr=?a, sem=<?v(?s)>] -> V[vform=?f, agr=?a, subcat=scomp, sem=<?v>] Sbar[sem=<?s>]
VP[vform=?f, agr=?a, sem=<?v(?q)>] -> V[vform=?f, agr=?a, subcat=qcomp, sem=<?v>] Qemb[sem=<?q>]
# "thank god I can see", "asked him what he thought"
VP[vform=?f, agr=?a, sem=<?v(?s, ?np)>] -> V[vform=?f, agr=?a, subcat=npscomp, sem=<?v>] NP[case=acc, expl=no, sem=<?np>] Sbar[sem=<?s>]
VP[vform=?f, agr=?a, sem=<?v(?q, ?np)>] -> V[vform=?f, agr=?a, subcat=npqcomp, sem=<?v>] NP[case=acc, expl=no, sem=<?np>] Qemb[sem=<?q>]
VP[vform=?f, agr=?a, sem=<?v(?vp)>] -> V[vform=?f, agr=?a, subcat=vpto, sem=<?v>] VP[vform=to, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<?v(?vp)>] -> V[vform=?f, agr=?a, subcat=vping, sem=<?v>] VP[vform=ing, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<?v(?vp)>] -> V[vform=?f, agr=?a, subcat=vpbase, sem=<?v>] VP[vform=base, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<?v(?vp, ?np)>] -> V[vform=?f, agr=?a, subcat=npvpto, sem=<?v>] NP[case=acc, expl=no, sem=<?np>] VP[vform=to, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<?v(?vp, ?np)>] -> V[vform=?f, agr=?a, subcat=npvpbase, sem=<?v>] NP[case=acc, expl=no, sem=<?np>] VP[vform=base, sem=<?vp>]
VP[vform=?f, agr=?a, sem=<?v(?ap)>] -> V[vform=?f, agr=?a, subcat=pred, sem=<?v>] AP[sem=<?ap>]
# a particle between a verb and its object: "call up the synonyms"
VP[vform=?f, agr=?a, sem=<\x F.?v(?np, x, \e.(?prt(e) & F(e)))>] -> V[vform=?f, agr=?a, subcat=tr, sem=<?v>] Prt[sem=<?prt>] NP[case=acc, expl=no, sem=<?np>]

VP[vform=to, subj=?e, ell=?l, sem=<?vp>] -> "to" VP[vform=base, subj=?e, ell=?l, sem=<?vp>]

# auxiliaries and modals, negated, and with the VP elided ("they always have")
VP[vform=?f, agr=?a, subj=?e, ell=?l, sem=<\x F.?aux(?vp(x, F))>] -> Aux[vform=?f, agr=?a, comp=?c, sem=<?aux>] VP[vform=?c, subj=?e, ell=?l, sem=<?vp>]
VP[vform=?f, agr=?a, subj=?e, ell=?l, sem=<\x F.?aux(?neg(?vp(x, F)))>] -> Aux[vform=?f, agr=?a, comp=?c, sem=<?aux>] Neg[sem=<?neg>] VP[vform=?c, subj=?e, ell=?l, sem=<?vp>]
VP[vform=?f, agr=?a, ell=yes, sem=<\x F.?aux(exists e.(elided(e) & Agent(e, x) & F(e)))>] -> Aux[vform=?f, agr=?a, ell=yes, sem=<?aux>]
VP[vform=?f, agr=?a, ell=yes, sem=<\x F.?aux(?neg(exists e.(elided(e) & Agent(e, x) & F(e))))>] -> Aux[vform=?f, agr=?a, ell=yes, sem=<?aux>] Neg[sem=<?neg>]

# the copula: its complement, a Pred, makes a state of the subject
VP[vform=?f, agr=?a, subj=?e, cop=yes, sem=<?p>] -> Be[vform=?f, agr=?a] Pred[subj=?e, sem=<?p>]
VP[vform=?f, agr=?a, subj=?e, cop=yes, sem=<\x F.?neg(?p(x, F))>] -> Be[vform=?f, agr=?a] Neg[sem=<?neg>] Pred[subj=?e, sem=<?p>]
VP[vform=?f, agr=?a, cop=yes, ell=yes, sem=<\x F.exists e.(be(e) & Theme(e, x) & F(e))>] -> Be[vform=?f, agr=?a]
VP[vform=?f, agr=?a, cop=yes, ell=yes, sem=<\x F.?neg(exists e.(be(e) & Theme(e, x) & F(e)))>] -> Be[vform=?f, agr=?a] Neg[sem=<?neg>]

Pred[subj=no, sem=<\x F.exists e.(be(e) & Theme(e, x) & ?np(\y.(x = y)) & F(e))>] -> NP[expl=no, sem=<?np>]
# existential "there": the state is of what the NP quantifies over
Pred[subj=there, sem=<\x F.?np(\y.exists e.(be(e) & Theme(e, y) & F(e)))>] -> NP[expl=no, sem=<?np>]
Pred[sem=<\x F.exists e.(be(e) & Theme(e, x) & ?ap(x) & F(e))>] -> AP[sem=<?ap>]
Pred[sem=<\x F.exists e.(be(e) & Theme(e, x) & ?pp(x) & F(e))>] -> PP[sem=<?pp>]
# "the goal is to test the interest"
Pred[sem=<\x F.exists e.(be(e) & Theme(e, x) & ?vp(x, \e2.true) & F(e))>] -> VP[vform=to, sem=<?vp>]
Pred[subj=?e, sem=<\x F.?adv(?p(x, F))>] -> Adv[type=op, sem=<?adv>] Pred[subj=?e, sem=<?p>]
Pred[subj=?e, sem=<\x F.?p(x, \e.(?adv(e) & F(e)))>] -> Adv[type=ev, sem=<?adv>] Pred[subj=?e, sem=<?p>]

# passives, with and without an agent
VP[vform=pass, sem=<\y F.exists x.?v(\P.P(y), x, F)>] -> V[vform=en, subcat=tr, sem=<?v>]
VP[vform=pass, sem=<\y F.?np(\x.?v(\P.P(y), x, F))>] -> V[vform=en, subcat=tr, sem=<?v>] "by" NP[case=acc, expl=no, sem=<?np>]
# "was thought to distract"
VP[vform=pass, sem=<\y F.exists x.?v(?vp, \P.P(y), x, F)>] -> V[vform=en, subcat=npvpto, sem=<?v>] VP[vform=to, sem=<?vp>]

# modifiers and coordination
VP[vform=?f, agr=?a, subj=?e, ell=?l, sem=<\x F.?adv(?vp(x, F))>] -> Adv[type=op, sem=<?adv>] VP[vform=?f, agr=?a, subj=?e, ell=?l, sem=<?vp>]
VP[vform=?f, agr=?a, subj=?e, ell=?l, sem=<\x F.?vp(x, \e.(?adv(e) & F(e)))>] -> Adv[type=ev, pre=yes, sem=<?adv>] VP[vform=?f, agr=?a, subj=?e, ell=?l, sem=<?vp>]
VP[vform=?f, agr=?a, subj=?e, ell=?l, sem=<\x F.?adv(?vp(x, F))>] -> VP[vform=?f, agr=?a, subj=?e, ell=?l, sem=<?vp>] Adv[type=op, sem=<?adv>]
VP[vform=?f, agr=?a, subj=?e, ell=?l, sem=<\x F.?vp(x, \e.(?adv(e) & F(e)))>] -> VP[vform=?f, agr=?a, subj=?e, ell=?l, sem=<?vp>] Adv[type=ev, sem=<?adv>]
# (a PP after the copula is its complement, not a modifier of the state;
# and elliptical VPs take no complements or adjuncts but adverbs)
VP[vform=?f, agr=?a, subj=?e, sem=<\x F.?vp(x, \e.(?pp(e) & F(e)))>] -> VP[vform=?f, agr=?a, subj=?e, cop=no, ell=no, sem=<?vp>] PP[sem=<?pp>]
VP[vform=?f, agr=?a, subj=?e, sem=<\x F.?vp(x, \e.(?prt(e) & F(e)))>] -> VP[vform=?f, agr=?a, subj=?e, sem=<?vp>] Prt[sem=<?prt>]
VP[vform=?f, agr=?a, subj=?e, sem=<\x F.?sub(?s(\e.true), ?vp(x, F))>] -> VP[vform=?f, agr=?a, subj=?e, sem=<?vp>] Sub[sem=<?sub>] S[sem=<?s>]
# purpose ("coming here to work") and participial ("wrote it using tags") adjuncts
VP[vform=?f, agr=?a, subj=?e, sem=<\x F.?vp1(x, \e.(Purpose(e, ?vp2(x, \e2.true)) & F(e)))>] -> VP[vform=?f, agr=?a, subj=?e, ell=no, sem=<?vp1>] VP[vform=to, sem=<?vp2>]
VP[vform=?f, agr=?a, subj=?e, sem=<\x F.(?vp1(x, F) & ?vp2(x, \e.true))>] -> VP[vform=?f, agr=?a, subj=?e, cop=no, ell=no, sem=<?vp1>] VP[vform=ing, sem=<?vp2>]
VP[vform=?f, agr=?a, sem=<\x F.?cj(?vp1(x, F), ?vp2(x, F))>] -> VP[vform=?f, agr=?a, sem=<?vp1>] Conj[sem=<?cj>] VP[vform=?f, agr=?a, sem=<?vp2>]

############################################################################
# Gaps
############################################################################

Sgap[sem=<\z F.?np(\x.?vp(z, x, F))>] -> NP[case=nom, agr=?a, expl=no, sem=<?np>] VPgap[vform=fin, agr=?a, sem=<?vp>]
SbarGap[sem=<\z.?s(z, \e.true)>] -> Sgap[sem=<?s>]

VPgap[vform=?f, agr=?a, sem=<\z.?v(\P.P(z))>] -> V[vform=?f, agr=?a, subcat=tr, sem=<?v>]
VPgap[vform=?f, agr=?a, sem=<\z.?v(?vp, \P.P(z))>] -> V[vform=?f, agr=?a, subcat=npvpto, sem=<?v>] VP[vform=to, sem=<?vp>]
VPgap[vform=?f, agr=?a, sem=<\z.?v(?s(z))>] -> V[vform=?f, agr=?a, subcat=scomp, sem=<?v>] SbarGap[sem=<?s>]
VPgap[vform=?f, agr=?a, sem=<\z.?v(?vp(z))>] -> V[vform=?f, agr=?a, subcat=vpto, sem=<?v>] VPgap[vform=to, sem=<?vp>]
VPgap[vform=to, sem=<?vp>] -> "to" VPgap[vform=base, sem=<?vp>]
VPgap[vform=?f, agr=?a, sem=<\z x F.?aux(?vp(z, x, F))>] -> Aux[vform=?f, agr=?a, comp=?c, sem=<?aux>] VPgap[vform=?c, sem=<?vp>]
VPgap[vform=?f, agr=?a, sem=<\z x F.exists e.(be(e) & Theme(e, x) & (x = z) & F(e))>] -> Be[vform=?f, agr=?a]
VPgap[vform=?f, agr=?a, sem=<\z x F.?adv(?vp(z, x, F))>] -> Adv[type=op, sem=<?adv>] VPgap[vform=?f, agr=?a, sem=<?vp>]
VPgap[vform=?f, agr=?a, sem=<\z x F.?vp(z, x, \e.(?adv(e) & F(e)))>] -> Adv[type=ev, pre=yes, sem=<?adv>] VPgap[vform=?f, agr=?a, sem=<?vp>]
VPgap[vform=?f, agr=?a, sem=<\z x F.?vp(z, x, \e.(?pp(e) & F(e)))>] -> VPgap[vform=?f, agr=?a, sem=<?vp>] PP[sem=<?pp>]
VPgap[vform=?f, agr=?a, sem=<\z x F.?vp(x, \e.(?pp(z, e) & F(e)))>] -> VP[vform=?f, agr=?a, sem=<?vp>] PPgap[sem=<?pp>]
PPgap[sem=<\z x.?p(x, z)>] -> P[sem=<?p>]

############################################################################
# Noun phrases
############################################################################

NP[agr=?a, expl=no, sem=<?d(?n)>] -> Det[agr=?a, sem=<?d>] Nom[agr=?a, sem=<?n>]
NP[agr=?a, expl=no, sem=<\Q.exists x.(?n(x) & Q(x))>] -> Nom[agr=?a, sem=<?n>]
NP[expl=no, sem=<\P.?cj(?np1(P), ?np2(P))>] -> NP[expl=no, sem=<?np1>] Conj[sem=<?cj>] NP[expl=no, sem=<?np2>]
# quantified pronouns, which can take a relative clause: "somebody who cares"
NP[agr=?a, expl=no, sem=<?d(?r)>] -> QPro[agr=?a, restr=<?r>, sem=<?d>]
NP[agr=?a, expl=no, sem=<?d(\x.(?r(x) & ?rc(x)))>] -> QPro[agr=?a, restr=<?r>, sem=<?d>] RelC[sem=<?rc>]
# partitives: "some of the analysis"
NP[expl=no, sem=<\Q.?d(\x.?np(\y.of(x, y)), Q)>] -> Det[sem=<?d>] "of" NP[case=acc, expl=no, sem=<?np>]
# free relatives: "what she said"
NP[agr=3sg, expl=no, free=yes, sem=<\Q.exists x.((?w(x) & ?s(x, \e.true)) & Q(x))>] -> Wh[free=yes, sem=<?w>] Sgap[sem=<?s>]
NP[agr=3sg, expl=no, free=yes, sem=<\Q.exists x.((?w(x) & ?vp(x, \e.true)) & Q(x))>] -> Wh[free=yes, sem=<?w>] VP[vform=fin, sem=<?vp>]

# possessives: "the guy's"
Det[sem=<\P Q.?np(\y.exists x.((P(x) & of(x, y)) & Q(x)))>] -> NP[expl=no, sem=<?np>] Poss[]

Nom[agr=?a, sem=<?n>] -> N[agr=?a, sem=<?n>]
Nom[agr=?a, sem=<\x.(?ap(x) & ?n(x))>] -> AP[sem=<?ap>] Nom[agr=?a, sem=<?n>]
# noun compounds: "school system"
Nom[agr=?a, sem=<\x.(?n(x) & exists y.(?m(y) & nn(x, y)))>] -> N[sem=<?m>] Nom[agr=?a, sem=<?n>]
Nom[agr=?a, sem=<\x.(?n(x) & ?pp(x))>] -> Nom[agr=?a, sem=<?n>] PP[sem=<?pp>]
Nom[agr=?a, sem=<\x.(?n(x) & ?r(x))>] -> Nom[agr=?a, sem=<?n>] RelC[sem=<?r>]
# infinitival and reduced relatives: "a factor to be considered", "kids shooting kids"
Nom[agr=?a, sem=<\x.(?n(x) & Purpose(x, ?vp(x, \e.true)))>] -> Nom[agr=?a, sem=<?n>] VP[vform=to, sem=<?vp>]
Nom[agr=?a, sem=<\x.(?n(x) & ?vp(x, \e.true))>] -> Nom[agr=?a, sem=<?n>] VP[vform=ing, sem=<?vp>]
Nom[agr=?a, sem=<\x.(?n(x) & ?vp(x, \e.true))>] -> Nom[agr=?a, sem=<?n>] VP[vform=pass, sem=<?vp>]
Nom[agr=?a, sem=<\x.?cj(?n1(x), ?n2(x))>] -> Nom[agr=?a, sem=<?n1>] Conj[sem=<?cj>] Nom[agr=?a, sem=<?n2>]

# relative clauses
RelC[sem=<\x.?vp(x, \e.true)>] -> Wh[free=no] VP[vform=fin, sem=<?vp>]
RelC[sem=<\x.?s(x, \e.true)>] -> Wh[free=no] Sgap[sem=<?s>] | Sgap[sem=<?s>]
RelC[sem=<\y.?s(\e.?w(e, y))>] -> WhAdv[sem=<?w>] S[sem=<?s>]

############################################################################
# Adjective and prepositional phrases
############################################################################

AP[sem=<?a>] -> A[subcat=none, sem=<?a>]
AP[sem=<?a(?vp)>] -> A[subcat=vpto, sem=<?a>] VP[vform=to, sem=<?vp>]
AP[sem=<\x.?adv(?ap(x))>] -> Adv[type=op, sem=<?adv>] AP[sem=<?ap>]
# "too many": many, few and several are otherwise determiners
AP[sem=<\x.?adv(?a(x))>] -> Adv[type=op, sem=<?adv>] A[subcat=deg, sem=<?a>]
AP[sem=<\x.(?ap(x) & ?pp(x))>] -> AP[sem=<?ap>] PP[sem=<?pp>]
AP[sem=<\x.?cj(?ap1(x), ?ap2(x))>] -> AP[sem=<?ap1>] Conj[sem=<?cj>] AP[sem=<?ap2>]

PP[sem=<\x.?np(\y.?p(x, y))>] -> P[sem=<?p>] NP[case=acc, expl=no, sem=<?np>]

############################################################################
# generated lexicon: everything below is written by tools/masc/lexicon.py
############################################################################

"&": Conj[sem=<\p q.(p & q)>]
